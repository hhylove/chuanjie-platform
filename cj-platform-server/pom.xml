<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.chuanjie</groupId>
  <artifactId>cj-platform-server</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>cj-platform-server</name>
  <description>创界新后台服务端（模块化单体）</description>

  <modules>
    <module>cj-dependencies</module>
    <module>cj-framework</module>
    <module>cj-server</module>
    <module>cj-module-platform</module>
    <module>cj-module-collaboration</module>
    <module>cj-module-oa-hr</module>
    <module>cj-module-project</module>
    <module>cj-module-product</module>
    <module>cj-module-operation-creative</module>
    <module>cj-module-supply-chain</module>
    <module>cj-module-finance</module>
    <module>cj-module-analytics-ai</module>
  </modules>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>3.5.0</spring-boot.version>
    <mybatis-plus.version>3.5.12</mybatis-plus.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.chuanjie</groupId>
        <artifactId>cj-framework</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.chuanjie</groupId>
        <artifactId>cj-module-platform-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.chuanjie</groupId>
        <artifactId>cj-module-platform-biz</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.chuanjie</groupId>
        <artifactId>cj-module-collaboration-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.chuanjie</groupId>
        <artifactId>cj-module-collaboration-biz</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.chuanjie</groupId>
        <artifactId>cj-module-oa-hr-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.chuanjie</groupId>
        <artifactId>cj-module-oa-hr-biz</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.chuanjie</groupId>
        <artifactId>cj-module-project-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.chuanjie</groupId>
        <artifactId>cj-module-project-biz</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.chuanjie</groupId>
        <artifactId>cj-module-product-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.chuanjie</groupId>
        <artifactId>cj-module-product-biz</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.chuanjie</groupId>
        <artifactId>cj-module-operation-creative-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.chuanjie</groupId>
        <artifactId>cj-module-operation-creative-biz</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.chuanjie</groupId>
        <artifactId>cj-module-supply-chain-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.chuanjie</groupId>
        <artifactId>cj-module-supply-chain-biz</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.chuanjie</groupId>
        <artifactId>cj-module-finance-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.chuanjie</groupId>
        <artifactId>cj-module-finance-biz</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.chuanjie</groupId>
        <artifactId>cj-module-analytics-ai-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.chuanjie</groupId>
        <artifactId>cj-module-analytics-ai-biz</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        <version>${mybatis-plus.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.14.0</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <encoding>UTF-8</encoding>
            <parameters>true</parameters>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
