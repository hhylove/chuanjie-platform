<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.12</version>
        <relativePath/>
    </parent>

    <groupId>com.chuanjie.platform</groupId>
    <artifactId>cj-platform-server</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Chuanjie Platform Server</name>

    <modules>
        <module>cj-dependencies</module>
        <module>cj-framework</module>
        <module>cj-module-platform-control</module>
        <module>cj-module-tenant-foundation</module>
        <module>cj-server</module>
    </modules>

    <properties>
        <!-- 生产运行基线；本机更高版本JDK仍按Java 21字节码编译。 -->
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <archunit.version>1.4.1</archunit.version>
        <!-- Spring Boot 3专用OpenAPI文档组件版本；统一管理避免模块自行漂移。 -->
        <springdoc.version>2.9.1</springdoc.version>
    </properties>
</project>
